PORT=3000
NODE_ENV=production

# Database
DATABASE_URL=./aetheris.db

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Session
SESSION_SECRET=your_session_secret_key_here_change_in_production

# Google OAuth (optional, leave empty if not using)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend URL
CLIENT_URL=https://aetheris.netlify.app
